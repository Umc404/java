package day11;

class Counter {
	// 싱글톤으로 생성
	private int count;
	// 객체저장 변수
	private static Counter instance;
	
	// 생성자 private
	private Counter() {}
	
	// 인스턴스를 1개만 생성해주는 메서드
	public static Counter getInstance() {
//		this.count = count;
		if(instance == null) {
			instance = new Counter();
		}
		return instance;
	}
	
	public int countMethod() {
		count++;
		return this.count;
	}
//	public static Counter getCount() {
//		if(instance == null) {
//			instance = new
//		}
//	}
}


public class Singleton02 {

	public static void main(String[] args) {
		/* Counter 객체 2개 생성하여 각각 countMethod() 호출
		 * 1개의 객체가 공유되기 때문에 1개의 변수만 변화
		 * 
		 */
		Counter c1 = Counter.getInstance();
		Counter c2 = Counter.getInstance();
		
		c1.countMethod();
		c2.countMethod();
		c1.countMethod();
		System.out.println("c1 : " + c1.countMethod());
		System.out.println("c2 : " + c2.countMethod());
	}

}
