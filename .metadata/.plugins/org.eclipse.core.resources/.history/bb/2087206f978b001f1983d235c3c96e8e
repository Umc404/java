create user 'javaUser'@'localhost' identified by 'mysql';

grant all privileges on javaDB.* to 'javaUser'@'localhost' with grant option;
flush privileges;
-- 위 create, grant 는 jdbc 패키지에서 처리함.

create table student (
num int auto_increment,
studnum varchar(10) not null,
studname varchar(10) not null,
admitflag int default 1,
birthdt varchar(15),
telnum varchar(15),
addr varchar(20),
regdate datetime default now(),
primary key(num)
);

