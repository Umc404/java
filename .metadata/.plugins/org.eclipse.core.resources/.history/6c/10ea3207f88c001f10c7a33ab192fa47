package fishing;

import java.sql.Connection;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.util.ArrayList;
import java.util.List;

public class InvenDAOImpl implements InvenDAO{

	@Override
	public List<Inventory> userInven(int userNum) {
		System.out.println("인벤토리 데이터 DAOImpl 확인 성공 ");
		query =   "select i.inven_id, i.num, i.fish_no, f.fish_name, i.fish_size from inventory as i "
				+ "inner join fish as f "
				+ "on i.fish_no = f.fish_no "
				+ "where i.num = ?";
		int num = userNum;
		List<Inventory> list = new ArrayList<>();
		try {
			pst = conn.prepareStatement(query);
			pst.setInt(1, num);
			
			ResultSet rs = pst.executeQuery();
			while(rs.next()) {
				list.add(new Inventory(rs.getInt("inven_id"),
									   rs.getString("fish_name"),
									   rs.getInt("fish_size")));
			}
			return list;
		} catch (SQLException e) {
			System.out.println("list error");
			e.printStackTrace();
		}
		return null;
	}
}
