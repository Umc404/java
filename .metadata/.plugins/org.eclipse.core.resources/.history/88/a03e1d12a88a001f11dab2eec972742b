package day11;

class Counter {
	// 싱글톤으로 생성
	private int count;
	// 호출하면 count++ 메서드 생성
	// countMethod()
	public int countMethod(int count) {
		this.count = count;
		return count++;
	}
}


public class Singleton02 {

	public static void main(String[] args) {
		/* Counter 객체 2개 생성하여 각각 countMethod() 호출
		 * 1개의 객체가 공유되기 때문에 1개의 변수만 변화
		 * 
		 */
		Counter c = new Counter();
		
	}

}
