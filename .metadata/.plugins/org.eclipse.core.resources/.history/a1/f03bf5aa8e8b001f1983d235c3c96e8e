package jdbc_student;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.util.ArrayList;
import java.util.List;

import jdbc.DatabaseConnection;

public class StudentDAOImp implements DAO {
	
	private Connection conn;
	private PreparedStatement pst;
	private String query = "";
	
	public StudentDAOImp() {
		DatabaseConnection dbc = DatabaseConnection.getInstance();
		conn = dbc.getConnection();
	}
	
	
	@Override
	public int insert(Student s) {
		// String stdnum, String stdname, String birthdt, String telnum, String addr
		System.out.println("insert DAOImp 성공");
		query = "insert into student(stdnum, stdname, birthdt, telnum, addr) values (?, ?, ?, ?, ?)";
		try {
			pst = conn.prepareStatement(query);
			pst.setString(1, s.getStdnum());
			pst.setString(2, s.getStdname());
			String date = s.getBirthdt().substring(0,2)				// year
					+ "-" + s.getBirthdt().substring(2,4)			// month
					+ "-" +s.getBirthdt().substring(4,6);			// day
			pst.setString(3, date);
			pst.setString(4, s.getTelnum());
			pst.setString(5, s.getAddr());
			return pst.executeUpdate();
		} catch (SQLException e) {
			System.out.println("insert error");
			e.printStackTrace();
		}
		return 0;
	}

	@Override
	public List<Student> list() {
		System.out.println("List DAOImp success. \n");
		
		query = "select * from student order by num desc";
		List<Student> list = new ArrayList<>();
		
		try {
			pst = conn.prepareStatement(query);
			ResultSet rs = pst.executeQuery();
			while(rs.next()) {
				list.add(new Student(rs.getString("stdnum"),
									 rs.getString("stdname")));
			}
			return list;
		} catch (SQLException e) {
			System.out.println("list error");
			e.printStackTrace();
		}
		
		
		return null;
	}

	@Override
	public Student search(String stdnum) {
		System.out.println("stdSearch DAOImp success \n");
		query = "select * from student where stdnum = ?";
		try {
			pst = conn.prepareStatement(query);
			pst.setString(1, stdnum);
			
			ResultSet rs = pst.executeQuery();
			if(rs.next()) {
				Student s = new Student(rs.getInt("num"),
										rs.getString("stdnum"),
										rs.getString("stdname"),
										rs.getInt("admitflag"),
										rs.getString("birthdt"),
										rs.getString("telnum"),
										rs.getString("addr"),
										rs.getString("regdate"));
				return s;
			}
		} catch (SQLException e) {
			System.out.println();
			e.printStackTrace();
		}
		return null;
	}

	@Override
	public int update(Student s) {
		// String stdname, String telnum, String addr, int num
		System.out.println("stdUpdate DAOImp success \n");
		System.out.println(s);
		query = "update student set stdname = ?, telnum = ?,"
				+ "addr = ? where stdnum = ?";
		try {
			pst = conn.prepareStatement(query);
			pst.setString(1, s.getStdname());
			pst.setString(2, s.getTelnum());
			pst.setString(3, s.getAddr());
			pst.setString(4, s.getStdnum());
			return pst.executeUpdate();
		} catch (SQLException e) {
			System.out.println("update error");
			e.printStackTrace();
		}
		// TODO Auto-generated method stub
		return 0;
	}

}
